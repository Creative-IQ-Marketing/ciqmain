# Netlify already serves HTML with "public, max-age=0, must-revalidate".
# Do not set Cache-Control on /* — it would collide with the long-lived rules below.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/paymentform
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted build output: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Un-fingerprinted static media: one year, revalidated by ETag if a file is
# ever replaced under the same name.
/hero/*
  Cache-Control: public, max-age=31536000
/events/*
  Cache-Control: public, max-age=31536000
/*.webp
  Cache-Control: public, max-age=31536000
/*.jpg
  Cache-Control: public, max-age=31536000
/*.png
  Cache-Control: public, max-age=31536000
/*.svg
  Cache-Control: public, max-age=31536000
/*.ico
  Cache-Control: public, max-age=31536000
/*.mp4
  Cache-Control: public, max-age=31536000
